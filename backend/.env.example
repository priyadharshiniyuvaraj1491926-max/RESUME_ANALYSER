# ResumeIQ AI Backend – Environment Variables Template
# Copy this file to .env and fill in real values.
# Never commit your .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq_ai

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── Frontend (CORS) ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set to 'openai', 'gemini', or 'none' (rule-based fallback)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# Token used by scripts/bootstrapAdmin.js to seed the first admin account.
# Leave empty to skip admin seeding.
ADMIN_BOOTSTRAP_TOKEN=
