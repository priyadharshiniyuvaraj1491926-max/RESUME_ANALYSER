PORT=8001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq_ai
JWT_SECRET=change_this_to_a_strong_64_character_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional Backend-Only LLM Provider (none | openai | gemini)
# When set to 'none' or when key is missing, deterministic rule-based analysis runs automatically.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional secure admin bootstrap token (usable only when zero admins exist in DB)
ADMIN_BOOTSTRAP_TOKEN=
